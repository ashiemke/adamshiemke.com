---
import type { MarkdownHeading } from 'astro';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import Toc from '../components/Toc.astro';
import { AUTHOR } from '../consts';

type Props = CollectionEntry<'blog'>['data'] & {
	headings?: MarkdownHeading[];
	readingMinutes?: number;
};

const { title, description, pubDate, updatedDate, status, heroImage, headings = [], readingMinutes } =
	Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} image={heroImage} type="article" />
	</head>
	<body>
		<a class="skip-link" href="#content">Skip to content</a>
		<div class="progress" aria-hidden="true"></div>
		<Header />
		<main class="post-shell">
			<div class="toc-rail">
				<Toc headings={headings} variant="rail" />
			</div>
			<article class="post" id="content">
				<header class="post-header">
					<p class="post-meta">
						{status && <span class="status">{status}</span>}
						<span class="byline">{AUTHOR}</span>
						<span class="post-meta-line">
							<FormattedDate date={pubDate} />
							{readingMinutes && (
								<>
									<span class="sep" aria-hidden="true">·</span>
									<span>{readingMinutes} min read</span>
								</>
							)}
						</span>
					</p>
					<h1 class="post-title">{title}</h1>
					{
						updatedDate && (
							<p class="post-updated">
								Updated <FormattedDate date={updatedDate} />
							</p>
						)
					}
				</header>
				{heroImage && <Image class="hero" width={1280} height={640} src={heroImage} alt="" />}
				<Toc headings={headings} variant="inline" />
				<div class="prose">
					<slot />
				</div>
			</article>
		</main>
		<Footer />

		<script>
			// Highlight the current section in the contents rail.
			const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')];
			const sections = links
				.map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1))))
				.filter((el): el is HTMLElement => el !== null);
			let ticking = false;
			function updateCurrent() {
				ticking = false;
				const offset = window.innerHeight * 0.25;
				let current = -1;
				sections.forEach((s, i) => {
					if (s.getBoundingClientRect().top - offset <= 0) current = i;
				});
				links.forEach((a, i) => {
					if (i === current) a.setAttribute('aria-current', 'true');
					else a.removeAttribute('aria-current');
				});
			}
			if (links.length) {
				window.addEventListener(
					'scroll',
					() => {
						if (!ticking) {
							ticking = true;
							requestAnimationFrame(updateCurrent);
						}
					},
					{ passive: true },
				);
				updateCurrent();
			}

			// Preview a note on hover or keyboard focus, so readers keep their place.
			const NOTE_LINKS = 'a[data-note-ref], a[data-footnote-ref]';
			const canHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
			const pop = document.createElement('div');
			pop.className = 'note-pop';
			pop.id = 'note-pop';
			pop.setAttribute('role', 'tooltip');
			document.body.append(pop);
			let hideTimer: number | undefined;

			function showFor(a: HTMLAnchorElement) {
				const target = document.getElementById(decodeURIComponent(a.hash.slice(1)));
				if (!target) return;
				const body = (target.querySelector('.note-body') ?? target).cloneNode(true) as HTMLElement;
				body
					.querySelectorAll('.backref, [data-footnote-backref]')
					.forEach((n) => n.remove());
				body.querySelectorAll('[id]').forEach((n) => n.removeAttribute('id'));
				pop.replaceChildren(...body.childNodes);
				pop.dataset.open = '';
				a.setAttribute('aria-describedby', 'note-pop');

				const r = a.getBoundingClientRect();
				const w = pop.offsetWidth;
				const h = pop.offsetHeight;
				const left = Math.min(Math.max(16, r.left + r.width / 2 - w / 2), window.innerWidth - w - 16);
				const below = r.bottom + 10;
				const top = below + h > window.innerHeight - 16 ? r.top - h - 10 : below;
				pop.style.left = `${left + window.scrollX}px`;
				pop.style.top = `${top + window.scrollY}px`;
			}
			function hideSoon() {
				hideTimer = window.setTimeout(() => {
					delete pop.dataset.open;
				}, 120);
			}
			function cancelHide() {
				window.clearTimeout(hideTimer);
			}

			if (canHover) {
				document.addEventListener('mouseover', (e) => {
					const a = (e.target as Element).closest<HTMLAnchorElement>(NOTE_LINKS);
					if (a) {
						cancelHide();
						showFor(a);
					}
				});
				document.addEventListener('mouseout', (e) => {
					if ((e.target as Element).closest(NOTE_LINKS)) hideSoon();
				});
				pop.addEventListener('mouseenter', cancelHide);
				pop.addEventListener('mouseleave', hideSoon);
			}
			document.addEventListener('focusin', (e) => {
				const a = (e.target as Element).closest<HTMLAnchorElement>(NOTE_LINKS);
				if (a) {
					cancelHide();
					showFor(a);
				}
			});
			document.addEventListener('focusout', (e) => {
				if ((e.target as Element).closest(NOTE_LINKS)) hideSoon();
			});
			document.addEventListener('click', (e) => {
				if ((e.target as Element).closest(NOTE_LINKS)) delete pop.dataset.open;
			});
			document.addEventListener('keydown', (e) => {
				if (e.key === 'Escape') delete pop.dataset.open;
			});
		</script>
	</body>
</html>
