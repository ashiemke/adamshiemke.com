---
import type { MarkdownHeading } from 'astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import Toc from '../components/Toc.astro';
import { AUTHOR } from '../consts';

// Standalone pages (like the README): same reading column as posts, without post-only metadata.
interface Props {
	title: string;
	description: string;
	updatedDate?: Date;
	headings?: MarkdownHeading[];
}

const { title, description, updatedDate, headings = [] } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body>
		<a class="skip-link" href="#content">Skip to content</a>
		<div class="progress" aria-hidden="true"></div>
		<Header />
		<main class="post-shell">
			<div class="toc-rail">
				<Toc headings={headings} variant="rail" />
			</div>
			<article class="post page" id="content">
				<header class="post-header">
					<p class="post-meta">
						<span class="byline">{AUTHOR}</span>
						{
							updatedDate && (
								<span class="post-meta-line">
									Updated <FormattedDate date={updatedDate} />
								</span>
							)
						}
					</p>
					<h1 class="post-title">{title}</h1>
				</header>
				<Toc headings={headings} variant="inline" />
				<div class="prose">
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
