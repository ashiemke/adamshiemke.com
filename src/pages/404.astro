---
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
// The README's messenger pigeon, still carrying a letter it can't deliver.
import pigeon from '../assets/drolleries/letter-pigeon.webp';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Page not found" description="This page does not exist." />
	</head>
	<body>
		<Header />
		<main class="home notfound" id="content">
			<Image class="notfound-art" src={pigeon} width={440} alt="" format="webp" />
			<h1 class="post-title">Page not found</h1>
			<p>There's nothing at this address. <a href="/">See all writing</a>.</p>
		</main>
		<Footer />
	</body>
</html>
