---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<a class="skip-link" href="#content">Skip to content</a>
		<Header />
		<main class="home" id="content">
			<h1 class="sr-only">{SITE_TITLE}</h1>
			<p class="home-intro">{SITE_DESCRIPTION}</p>
			<h2 class="section-label">Writing</h2>
			<ul class="post-list">
				{
					posts.map((post) => (
						<li>
							<p class="post-list-meta">
								<FormattedDate date={post.data.pubDate} month="short" />
								{post.data.status && <span class="status">{post.data.status}</span>}
							</p>
							<h3 class="post-list-title">
								<a href={`/blog/${post.id}/`}>{post.data.title}</a>
							</h3>
							<p class="post-list-desc">{post.data.description}</p>
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
	</body>
</html>
