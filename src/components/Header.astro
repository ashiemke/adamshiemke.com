---
import { SITE_TITLE } from '../consts';

const path = Astro.url.pathname;
const isHome = path === '/';
const isReadme = path.startsWith('/readme');
---

<header class="site-header">
	<a class="wordmark" href="/">{SITE_TITLE}</a>
	<nav class="site-nav" aria-label="Site">
		<a href="/" aria-current={isHome ? 'page' : undefined}>Writing</a>
		<a href="/readme/" aria-current={isReadme ? 'page' : undefined}>README</a>
		<a href="/rss.xml">RSS</a>
		<button class="theme-toggle" type="button" aria-label="Switch to dark mode" hidden>
			<svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true">
				<path fill="currentColor" d="M20.5 14.6A8.6 8.6 0 0 1 9.4 3.5a8.6 8.6 0 1 0 11.1 11.1Z"></path>
			</svg>
			<svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true">
				<circle cx="12" cy="12" r="4.4" fill="currentColor"></circle>
				<path
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M5.3 18.7l1.6-1.6M17.1 6.9l1.6-1.6"
				></path>
			</svg>
		</button>
	</nav>
</header>

<script>
	// Light/dark switch. BaseHead sets data-theme before paint; this keeps it, the button
	// label and the browser's theme colour in step, and remembers an explicit choice.
	const button = document.querySelector<HTMLButtonElement>('.theme-toggle');
	const root = document.documentElement;
	const THEME_COLOR = { light: '#f4ecda', dark: '#1b1711' };

	function apply(theme: 'light' | 'dark') {
		root.dataset.theme = theme;
		document
			.querySelectorAll<HTMLMetaElement>('meta[name="theme-color"]')
			.forEach((meta) => (meta.content = THEME_COLOR[theme]));
		button?.setAttribute('aria-label', theme === 'dark' ? 'Switch to light mode' : 'Switch to dark mode');
	}

	function saved() {
		try {
			return localStorage.getItem('theme');
		} catch {
			return null;
		}
	}

	if (button) {
		button.hidden = false;
		apply(root.dataset.theme === 'dark' ? 'dark' : 'light');
		button.addEventListener('click', () => {
			const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
			try {
				localStorage.setItem('theme', next);
			} catch {}
			apply(next);
		});
		// Until the reader picks a theme, follow the system setting as it changes.
		matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
			if (!saved()) apply(e.matches ? 'dark' : 'light');
		});
	}
</script>
