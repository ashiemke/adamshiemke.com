---
import type { ImageMetadata } from 'astro';

/**
 * A marginal drawing (drollery) that jokes about the section it sits in.
 * Put it right after the section's opening paragraph:  <Drollery art="knight-snail" />
 * WebP illustrations and inline SVG drawings share the same placement.
 * The artwork is decorative and the surrounding prose carries the argument.
 *
 * width: display width (default 13rem on narrow screens; capped at 12.25rem in the margin).
 * top:   how far to pull it up beside the heading on wide screens (default -5.5rem).
 */
interface Props {
	art: string;
	width?: string;
	top?: string;
}

const { art, width, top } = Astro.props;
const drawings = import.meta.glob<string>('../assets/drolleries/*.svg', {
	query: '?raw',
	import: 'default',
	eager: true,
});
const illustrations = import.meta.glob<ImageMetadata>('../assets/drolleries/*.webp', {
	import: 'default',
	eager: true,
});
const illustration = illustrations[`../assets/drolleries/${art}.webp`];
const svg = drawings[`../assets/drolleries/${art}.svg`];
if (!illustration && !svg) throw new Error(`Drollery "${art}" not found in src/assets/drolleries/`);
const style = [width && `--dr-w: ${width}`, top && `--dr-top: ${top}`].filter(Boolean).join('; ');
---

<div class:list={['drollery', { 'drollery-painted': illustration }]} aria-hidden="true" style={style || undefined}>
	{
		illustration ? (
			<img
				src={illustration.src}
				width={illustration.width}
				height={illustration.height}
				alt=""
				loading="lazy"
				decoding="async"
			/>
		) : (
			<Fragment set:html={svg} />
		)
	}
</div>
