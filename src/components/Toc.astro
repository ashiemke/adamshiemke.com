---
import type { MarkdownHeading } from 'astro';

interface Props {
	headings: MarkdownHeading[];
	variant: 'rail' | 'inline';
}

const { headings, variant } = Astro.props;
const NUMBERED = /^(\d+)\.?\s+(.*)$/;
const items = headings
	.filter((h) => h.depth === 2 && h.slug !== 'footnote-label')
	.map((h) => {
		const m = h.text.match(NUMBERED);
		return { slug: h.slug, num: m?.[1], text: m ? m[2] : h.text };
	});
---

{
	items.length > 2 &&
		(variant === 'rail' ? (
			<nav class="toc toc-rail-nav" aria-label="Contents">
				<p class="toc-label">Contents</p>
				<ol>
					{items.map((i) => (
						<li>
							<a href={`#${i.slug}`} data-toc-link>
								<span class="toc-num">{i.num}</span>
								<span>{i.text}</span>
							</a>
						</li>
					))}
				</ol>
			</nav>
		) : (
			<details class="toc toc-inline">
				<summary>Contents</summary>
				<ol>
					{items.map((i) => (
						<li>
							<a href={`#${i.slug}`}>
								<span class="toc-num">{i.num}</span>
								<span>{i.text}</span>
							</a>
						</li>
					))}
				</ol>
			</details>
		))
}

<script>
	// Highlight the current section in the contents rail.
	const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')];
	const sections = links
		.map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1))))
		.filter((el): el is HTMLElement => el !== null);
	let ticking = false;
	function updateCurrent() {
		ticking = false;
		const offset = window.innerHeight * 0.25;
		let current = -1;
		sections.forEach((s, i) => {
			if (s.getBoundingClientRect().top - offset <= 0) current = i;
		});
		links.forEach((a, i) => {
			if (i === current) a.setAttribute('aria-current', 'true');
			else a.removeAttribute('aria-current');
		});
	}
	if (links.length) {
		window.addEventListener(
			'scroll',
			() => {
				if (!ticking) {
					ticking = true;
					requestAnimationFrame(updateCurrent);
				}
			},
			{ passive: true },
		);
		updateCurrent();
	}
</script>
